{
    "name": "electrik/teamwork",
    "version": "11.0.1",
    "license": "MIT",
    "description": "Electrik fork of mpociot/teamwork — user/team associations with invites for Laravel 10–13.",
    "keywords": [
        "Teams",
        "Invite",
        "Laravel",
        "Electrik"
    ],
    "homepage": "https://github.com/electrikhq/teamwork",
    "authors": [
        {
            "name": "Marcel Pociot",
            "email": "m.pociot@gmail.com"
        },
        {
            "name": "Oliver Kaufmann",
            "email": "okaufmann91@gmail.com"
        },
        {
            "name": "neerajsohal",
            "email": "hello@electrik.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/electrikhq/teamwork/issues",
        "source": "https://github.com/electrikhq/teamwork"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "mpociot/teamwork": "self.version"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Mpociot\\Teamwork\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mpociot\\Teamwork\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mpociot\\Teamwork\\TeamworkServiceProvider"
            ],
            "aliases": {
                "Teamwork": "Mpociot\\Teamwork\\Facades\\Teamwork"
            }
        },
        "branch-alias": {
            "dev-main": "11.0.x-dev"
        }
    }
}
